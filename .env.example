# ==============================================================================
# Anmol Vastralay - Root Environment Variables Template
# Copy this file to .env before starting containers with docker-compose
# ==============================================================================

# Node Environment
NODE_ENV=development

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=anmol_db

# Redis Cache & Message Queue
REDIS_URL=redis://redis:6379

# Backend API Configuration
BACKEND_PORT=3001
JWT_SECRET=replace_with_a_secure_random_string_in_production

# Initial Administrator Credentials (used for initial DB provisioning)
ADMIN_EMAIL=admin@anmolvastralay.com
ADMIN_PASSWORD=your_initial_secure_admin_password

# Client URLs (CORS & Redirects)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# Cloudinary (Media & Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay (Payments & Webhooks)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# AI & Recommendations Service
GEMINI_API_KEY=your_google_gemini_api_key
AI_SERVICE_INTERNAL_TOKEN=your_secure_internal_token
