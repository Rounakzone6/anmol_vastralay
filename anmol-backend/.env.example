# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection string (required)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://neondb_owner:npg_SNKVtp8Dbaq5@ep-hidden-darkness-b4b7yho7-pooler.c-6.us-east-2.aws.neon.tech/anmol_db?sslmode=require&channel_binding=require

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Set true for hosted PostgreSQL providers that require TLS (for example Neon).
DATABASE_SSL=true
# Optional: use Neon’s direct (non-pooler) URI for `prisma migrate deploy`.
DIRECT_DATABASE_URL=postgresql://neondb_owner:npg_SNKVtp8Dbaq5@ep-hidden-darkness-b4b7yho7-pooler.c-6.us-east-2.aws.neon.tech/anmol_db?sslmode=require&channel_binding=require

# API server port (storefront uses 3000, admin uses 3002)
PORT=3001
NODE_ENV=development
# Options: development | staging | production

# ============================================================================
# AUTHENTICATION
# ============================================================================
# JWT secret key for token signing (change in production!)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ============================================================================
# FRONTEND & ADMIN (CORS)
# ============================================================================
# Frontend storefront URL (for CORS whitelisting)
FRONTEND_URL=http://localhost:3000
# Admin dashboard URL (for CORS whitelisting)
ADMIN_URL=http://localhost:3002

# ============================================================================
# CLOUDINARY (Image Storage & Optimization)
# ============================================================================
# Required for product image uploads and hosting
# Get from: https://cloudinary.com/console/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================================================
# GOOGLE OAUTH (Customer Sign-in)
# ============================================================================
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================================================
# RAZORPAY (Payment Processing)
# ============================================================================
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ============================================================================
# SMTP EMAIL (OTP)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_SECURE=false

# ============================================================================
# LOGGING (Optional)
# ============================================================================
LOG_LEVEL=info
# Options: debug | info | warn | error

# ============================================================================
# RATE LIMITING
# ============================================================================
# Number of requests allowed
THROTTLE_LIMIT=100
# Time window in seconds
THROTTLE_TTL=60
