generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ProductKind {
  SAREE
  STANDARD
}


model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  phone           String?   @unique
  googleId        String?   @unique
  name            String?
  password        String?
  profileImage    String?
  profileImageId  String?
  gender          Gender?
  dateOfBirth     DateTime?
  emailVerified   Boolean   @default(false)
  phoneVerified   Boolean   @default(false)
  role            UserRole  @default(STAFF)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  addresses    Address[]
  cart         Cart?
  orders       Order[]
  payments     Payment[]
  interactions ProductInteraction[]
  otpCodes     OtpCode[]
  reviews      Review[]
}

enum OtpType {
  EMAIL
  PHONE
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      OtpType
  code      String
  target    String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  metaTitle   String?
  metaDescription String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products      Product[]
  subcategories Subcategory[]
}

model Subcategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  metaTitle   String?
  metaDescription String?
  isActive    Boolean    @default(true)
  categoryId  String
  category    Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  itemTypes   ItemType[]
  products    Product[]
}

model ItemType {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  description   String?
  metaTitle     String?
  metaDescription String?
  isActive      Boolean     @default(true)
  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  products      Product[]
}

model Product {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?          @db.Text
  metaTitle       String?
  metaDescription String?
  brand           String?
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  subcategoryId   String?
  subcategory     Subcategory?     @relation(fields: [subcategoryId], references: [id])
  itemTypeId      String?
  itemType        ItemType?        @relation(fields: [itemTypeId], references: [id])
  kind            ProductKind      @default(STANDARD)
  netPrice        Decimal          @db.Decimal(10, 2)
  discountPercent Decimal          @default(0) @db.Decimal(5, 2)
  allowsExtraSaya Boolean          @default(false)
  extraSayaPrice  Decimal?         @db.Decimal(10, 2)
  isActive        Boolean          @default(true)
  images          ProductImage[]
  variants        ProductVariant[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  cartItems       CartItem[]
  orderItems      OrderItem[]
  interactions    ProductInteraction[]
  reviews         Review[]
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  publicId  String?
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ProductVariant {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  color      String
  size       String?
  /// Empty for saree; M/L/XL/XXL for standard — used in unique constraint
  sizeKey    String       @default("")
  stockQty   Int          @default(0)
  sku        String?      @unique
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, color, sizeKey])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("Home")
  fullName  String?
  phone     String?
  street    String
  city      String
  state     String
  country   String
  zipCode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cartId, productId, variantId])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REPLACED
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal     @db.Decimal(10, 2)
  shippingAddress String
  items           OrderItem[]
  payments        Payment[]
  returnRequests  ReturnRequest[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  invoiceNumber   String?     @unique
  invoiceUrl      String?
  invoicePublicId String?
  invoiceCreatedAt DateTime?
  statusHistory   OrderStatusHistory[]
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
  price     Decimal         @db.Decimal(10, 2)
  returnRequestsAsOriginal    ReturnRequest[] @relation("OriginalItem")
  returnRequestsAsReplacement ReturnRequest?  @relation("ReplacementItem")
}

enum ReturnType {
  REFUND
  REPLACEMENT
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model ReturnRequest {
  id                  String       @id @default(cuid())
  orderId             String
  order               Order        @relation(fields: [orderId], references: [id])
  originalItemId      String       // The OrderItem being returned
  originalItem        OrderItem    @relation("OriginalItem", fields: [originalItemId], references: [id])
  type                ReturnType
  status              ReturnStatus @default(PENDING)
  reason              String?
  // If replacement, link to the new OrderItem that was sent as a replacement
  replacementItemId   String?      @unique
  replacementItem     OrderItem?   @relation("ReplacementItem", fields: [replacementItemId], references: [id])
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  paymentMethod String?
  transactionId String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum BannerPlacement {
  HERO
  PROMO
  CATEGORY
}

model Banner {
  id          String          @id @default(cuid())
  title       String
  subtitle    String?
  buttonText  String?
  imageUrl    String
  publicId    String?
  placement   BannerPlacement @default(HERO)
  linkUrl     String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model SiteVisit {
  id        String   @id @default(cuid())
  sessionId String   @unique
  userAgent String?
  createdAt DateTime @default(now())
}

enum InteractionType {
  VIEW
  ADD_TO_CART
  PURCHASE
}

model ProductInteraction {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  action    InteractionType
  createdAt DateTime        @default(now())
}

model Review {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating          Int      // 1 to 5
  title           String?
  comment         String?  @db.Text
  isVerifiedBuyer Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId, userId]) // Limit to 1 review per product per user
}
